{
  "name": "gvim-marker-folds",
  "displayName": "GVim Marker Folds",
  "description": "GVim Marker Folds \u2014 independently maintained local extension.",
  "publisher": "local",
  "version": "0.2.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gvimMarkerFolds.createFold",
        "title": "gvimMarkerFolds.createFold"
      },
      {
        "command": "gvimMarkerFolds.deleteFold",
        "title": "gvimMarkerFolds.deleteFold"
      },
      {
        "command": "gvimMarkerFolds.deleteFoldRecursive",
        "title": "GVim: Delete folds recursively"
      },
      {
        "command": "gvimMarkerFolds.deleteAllFolds",
        "title": "GVim: Delete all marker folds"
      },
      {
        "command": "gvimMarkerFolds.toggleFoldRecursive",
        "title": "GVim: toggleFoldRecursive"
      },
      {
        "command": "gvimMarkerFolds.viewCursor",
        "title": "GVim: viewCursor"
      },
      {
        "command": "gvimMarkerFolds.foldMore",
        "title": "GVim: foldMore"
      },
      {
        "command": "gvimMarkerFolds.foldLess",
        "title": "GVim: foldLess"
      },
      {
        "command": "gvimMarkerFolds.disableFolds",
        "title": "GVim: disableFolds"
      },
      {
        "command": "gvimMarkerFolds.enableFolds",
        "title": "GVim: enableFolds"
      },
      {
        "command": "gvimMarkerFolds.toggleFolds",
        "title": "GVim: toggleFolds"
      },
      {
        "command": "gvimMarkerFolds.nextFold",
        "title": "GVim: nextFold"
      },
      {
        "command": "gvimMarkerFolds.previousFold",
        "title": "GVim: previousFold"
      },
      {
        "command": "gvimMarkerFolds.foldStart",
        "title": "GVim: foldStart"
      },
      {
        "command": "gvimMarkerFolds.foldEnd",
        "title": "GVim: foldEnd"
      },
      {
        "command": "gvimMarkerFolds.updateFolds",
        "title": "GVim: updateFolds"
      },
      {
        "command": "gvimMarkerFolds.resetFolds",
        "title": "GVim: resetFolds"
      }
    ],
    "configuration": {
      "title": "GVim Marker Folds",
      "properties": {
        "gvimMarkerFolds.commentStrings": {
          "type": "object",
          "default": {},
          "description": "Safe per-language marker comment formats. Empty string disables creation."
        }
      }
    }
  },
  "extensionDependencies": [
    "vscodevim.vim"
  ]
}
